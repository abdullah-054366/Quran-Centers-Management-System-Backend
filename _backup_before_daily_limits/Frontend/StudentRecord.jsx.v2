import { useEffect, useMemo, useState } from "react";
import { CalendarCheck, CalendarDays, ChevronDown, Pencil, UserRound } from "lucide-react";
import { Link, useParams } from "react-router";
import { getSurahMeta } from "quran-meta/hafs";
import { getAttendance } from "../../api/attendance";
import { getMemorizationRecords } from "../../api/memorization";
import { DEFAULT_STUDY_DAYS, getStudyDays } from "../../api/studentRecord";
import ayahLines from "../../data/ayahLines.json";
import { aggregateRecords, createLineCalculator } from "../../lib/quranLines";
import {
  WEEKDAY_NAMES, buildMonthRows, countAttendedDays, mergeSessionRecords, normalizeRecord, toDateKey,
} from "../../lib/studentRecord";

const PAGE_SIZE = 31; // شهر كامل في صفحة واحدة (1\1) مثل التصميم
const calculator = createLineCalculator(ayahLines);
const fmt = (n) => new Intl.NumberFormat("en", { maximumFractionDigits: 2 }).format(n);
const stripTashkeel = (text) => text.replace(/[\u064B-\u065F\u0670\u06D6-\u06ED]/g, "");
const surahName = (n) => stripTashkeel(getSurahMeta(n).name);
const dash = <span className="text-slate-300">—</span>;

const controlClass =
  "min-h-11 rounded-xl border border-slate-200 bg-white px-3 text-sm outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/10";

function todayMonth() {
  return new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Riyadh", year: "numeric", month: "2-digit" })
    .format(new Date()).slice(0, 7);
}

// نفس ألوان شارات الحالة في صفحة الحضور والغياب
const statusLabels = { 1: "حاضر", 2: "غائب", 3: "متأخر", 4: "مستأذن" };
const statusStyles = {
  1: "border-emerald-200 bg-emerald-50 text-emerald-800",
  2: "border-rose-200 bg-rose-50 text-rose-700",
  3: "border-amber-200 bg-amber-50 text-amber-800",
  4: "border-sky-200 bg-sky-50 text-sky-800",
};

function StatsBlock({ title, stats }) {
  return (
    <div className="rounded-2xl border border-slate-100 bg-slate-50 p-4">
      <h3 className="text-sm font-extrabold text-slate-700">{title}</h3>
      <dl className="mt-3 grid grid-cols-2 gap-3 text-sm">
        <div><dt className="text-xs text-slate-400">صفحات كاملة</dt><dd className="font-extrabold text-slate-800">{fmt(stats.fullPages)}</dd></div>
        <div><dt className="text-xs text-slate-400">المتبقي</dt><dd className="font-extrabold text-slate-800">{fmt(stats.remainderLines)} سطر ({fmt(stats.remainderPage)} صفحة)</dd></div>
        <div><dt className="text-xs text-slate-400">الإجمالي عشريًا</dt><dd className="font-extrabold text-emerald-800">{fmt(stats.decimalPages)} صفحة</dd></div>
        <div><dt className="text-xs text-slate-400">إجمالي الأسطر</dt><dd className="font-extrabold text-slate-800">{fmt(stats.totalLines)}</dd></div>
      </dl>
    </div>
  );
}

export default function StudentRecord() {
  const [attendance, setAttendance] = useState([]);
  const [rawRecords, setRawRecords] = useState([]);
  const [studyDays, setStudyDays] = useState(DEFAULT_STUDY_DAYS);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const { studentId: routeStudentId } = useParams();
  const [studentId, setStudentId] = useState(routeStudentId ? Number(routeStudentId) : null);
  const [query, setQuery] = useState("");
  const [month, setMonth] = useState(todayMonth());
  const [page, setPage] = useState(1);
  const [showStats, setShowStats] = useState(false);
  const [rangeFrom, setRangeFrom] = useState("");
  const [rangeTo, setRangeTo] = useState("");

  // نطاق جلب سجلات الحفظ: الشهر المعروض + النطاق المخصص (إن وُجد).
  // الخادم يعيد آخر 200 سجل فقط بلا فلتر، لذلك نطلب التاريخ صراحةً.
  const [y, m] = month.split("-").map(Number);
  const monthStart = `${month}-01`;
  const monthEnd = `${month}-${String(new Date(Date.UTC(y, m, 0)).getUTCDate()).padStart(2, "0")}`;
  const fetchFrom = [monthStart, rangeFrom].filter(Boolean).sort()[0];
  const fetchTo = [monthEnd, rangeTo].filter(Boolean).sort().at(-1);

  useEffect(() => {
    let current = true;
    (async () => {
      try {
        const [att, days] = await Promise.all([getAttendance(), getStudyDays()]);
        if (!current) return;
        setAttendance(Array.isArray(att) ? att : att?.data ?? []);
        setStudyDays(days);
      } catch (e) {
        console.error("Error loading attendance:", e);
        if (current) setError("تعذّر تحميل سجل الطالب.");
      }
    })();
    return () => { current = false; };
  }, []);

  useEffect(() => {
    let current = true;
    setLoading(true);
    (async () => {
      try {
        const rec = await getMemorizationRecords({ from: fetchFrom, to: fetchTo });
        if (!current) return;
        setRawRecords(Array.isArray(rec) ? rec : rec?.data ?? []);
        setError("");
      } catch (e) {
        console.error("Error loading memorization records:", e);
        if (current) setError("تعذّر تحميل سجل الطالب.");
      } finally {
        if (current) setLoading(false);
      }
    })();
    return () => { current = false; };
  }, [fetchFrom, fetchTo]);

  // الجلسة التي تضم عدة سور تظهر سجلاً واحداً: من أول سورة وآية إلى آخر سورة وآية.
  const records = useMemo(
    () =>
      mergeSessionRecords(
        rawRecords.map(normalizeRecord).filter((r) => r.type),
        (surah) => getSurahMeta(surah).ayahCount,
      ),
    [rawRecords],
  );

  const students = useMemo(() => {
    const map = new Map();
    for (const a of attendance) if (!map.has(a.studentId)) map.set(a.studentId, a.studentName || "غير معروف");
    for (const r of records) if (!map.has(r.studentId)) map.set(r.studentId, r.studentName || "غير معروف");
    return [...map.entries()].map(([id, name]) => ({ id, name }));
  }, [attendance, records]);

  const selectedId = studentId ?? students[0]?.id ?? null;
  const student = students.find((s) => s.id === selectedId);
  const matches = query.trim() ? students.filter((s) => s.name.includes(query.trim())).slice(0, 6) : [];

  const studentAttendance = useMemo(() => attendance.filter((a) => a.studentId === selectedId), [attendance, selectedId]);
  const studentRecords = useMemo(() => records.filter((r) => r.studentId === selectedId), [records, selectedId]);

  const rows = useMemo(
    () => buildMonthRows({ monthKey: month, studyDays, attendance: studentAttendance, records: studentRecords, calculator }),
    [month, studyDays, studentAttendance, studentRecords],
  );

  const monthStats = useMemo(
    () => aggregateRecords(studentRecords, calculator, { from: `${month}-01`, to: `${month}-31` }),
    [studentRecords, month],
  );
  const rangeStats = useMemo(
    () => (rangeFrom || rangeTo
      ? aggregateRecords(studentRecords, calculator, { from: rangeFrom || undefined, to: rangeTo || undefined })
      : null),
    [studentRecords, rangeFrom, rangeTo],
  );

  const pageCount = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
  const safePage = Math.min(page, pageCount);
  const visibleRows = rows.slice((safePage - 1) * PAGE_SIZE, safePage * PAGE_SIZE);
  const attendedDays = countAttendedDays(
    studentAttendance
      .filter((a) => toDateKey(a.attendanceDate).startsWith(month))
      .map((a) => ({ status: a.status })),
  );
  const monthNumber = Number(month.slice(5, 7));
  const monthLabel = `${month.slice(0, 4)}/${monthNumber}`;
  const dateLabel = (date) => `${Number(date.slice(5, 7))}\\${Number(date.slice(8, 10))}`;

  const headers = ["اليوم", "التسجيل", "تاريخ اليوم", "من", "الى", "عدد الآيات", "عدد الصفحات"];

  return (
    <main dir="rtl" className="mx-auto max-w-5xl space-y-6">
      <header>
        <h1 className="text-2xl font-extrabold text-slate-800">سجل طالب</h1>
        <p className="mt-1 text-sm text-slate-400">حضور الطالب وحفظه ومراجعته خلال الشهر.</p>
      </header>

      {/* البحث + الشهر + تعديل التسجيل */}
      <div className="grid gap-3 md:grid-cols-[1fr_auto_auto]">
        <div className="relative">
          <input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="بحث عن طالب ..."
            aria-label="بحث عن طالب"
            className={`${controlClass} w-full`}
          />
          {matches.length > 0 && (
            <ul className="absolute z-20 mt-1 w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg">
              {matches.map((s) => (
                <li key={s.id}>
                  <button
                    type="button"
                    onClick={() => { setStudentId(s.id); setQuery(""); setPage(1); }}
                    className="w-full px-4 py-2.5 text-right text-sm hover:bg-emerald-50"
                  >
                    {s.name}
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>

        <label className={`${controlClass} relative flex cursor-pointer items-center justify-center gap-2 font-bold text-slate-700`}>
          <CalendarDays size={17} className="text-emerald-800" />
          <span dir="ltr">{monthLabel}</span>
          <ChevronDown size={16} className="text-slate-400" />
          <input
            type="month"
            value={month}
            aria-label="الشهر"
            onClick={(e) => e.currentTarget.showPicker?.()}
            onChange={(e) => { if (e.target.value) { setMonth(e.target.value); setPage(1); } }}
            className="absolute inset-0 h-full w-full cursor-pointer opacity-0"
          />
        </label>

        <Link
          to="/attendance/register"
          className="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-emerald-800 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-900"
        >
          <Pencil size={16} />
          تعديل التسجيل
        </Link>
      </div>

      {/* بطاقتا اسم الطالب وإجمالي الحضور */}
      <div className="grid gap-4 md:grid-cols-2">
        <section className="flex items-center gap-4 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm md:p-5">
          <span className="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-emerald-50 text-emerald-800">
            <UserRound size={28} />
          </span>
          <div className="min-w-0">
            <p className="text-xs font-semibold text-slate-400">اسم الطالب</p>
            <p className="mt-1 truncate text-lg font-extrabold text-slate-800">{student?.name ?? "—"}</p>
          </div>
        </section>

        <section className="flex items-center justify-between gap-4 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm md:p-5">
          <div>
            <p className="text-xs font-semibold text-slate-400">إجمالي الحضور شهر {monthNumber}</p>
            <p className="mt-1 text-4xl font-extrabold leading-none text-emerald-800">{attendedDays}</p>
          </div>
          <span className="grid h-14 w-14 shrink-0 place-items-center rounded-xl bg-emerald-800 text-white">
            <CalendarCheck size={26} />
          </span>
        </section>
      </div>

      {/* الجدول */}
      <section className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        {loading ? (
          <p className="p-10 text-center text-sm text-slate-500">جارٍ تحميل السجل…</p>
        ) : error ? (
          <p role="alert" className="p-10 text-center text-sm text-rose-600">{error}</p>
        ) : (
          <div className="max-h-[560px] overflow-auto">
            <table className="w-full min-w-[720px] border-collapse text-sm text-slate-700">
              <thead className="sticky top-0 z-10 bg-slate-50">
                <tr className="border-b border-slate-200 text-xs text-slate-500">
                  {headers.map((h, i) => (
                    <th key={h} className={`px-4 py-3 font-extrabold ${i === 0 ? "text-right" : "text-center"}`}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {visibleRows.map((row) => {
                  const entries = row.entries.length ? row.entries : [null];
                  return entries.map((entry, i) => (
                    <tr key={`${row.date}-${i}`} className="border-b border-slate-100 last:border-b-0">
                      <td className="px-4 py-3 text-right font-bold text-slate-700">{i === 0 ? WEEKDAY_NAMES[row.weekday] : ""}</td>
                      <td className="px-2 py-3 text-center">
                        {i === 0 && (row.status ? (
                          <span className={`inline-flex min-w-16 justify-center rounded-full border px-3 py-1 text-xs font-bold ${statusStyles[row.status] ?? ""}`}>
                            {statusLabels[row.status] ?? "غير محدد"}
                          </span>
                        ) : dash)}
                      </td>
                      <td className="px-2 py-3 text-center">{i === 0 ? dateLabel(row.date) : ""}</td>
                      {!entry ? (
                        [0, 1, 2, 3].map((k) => <td key={k} className="px-2 py-3 text-center">{dash}</td>)
                      ) : entry.error ? (
                        <td colSpan={4} className="px-2 py-3 text-center text-xs text-rose-600">سجل غير صالح: {entry.error}</td>
                      ) : (
                        <>
                          <td className="px-2 py-3 text-center">
                            {surahName(entry.fromSurah)} - {entry.fromAyah}
                            <span className={`mr-2 rounded-full px-2 py-0.5 text-[11px] font-bold ${entry.type === "review" ? "bg-sky-50 text-sky-800" : "bg-emerald-50 text-emerald-800"}`}>
                              {entry.type === "review" ? "مراجعة" : "حفظ"}
                            </span>
                          </td>
                          <td className="px-2 py-3 text-center">{surahName(entry.toSurah)} - {entry.toAyah}</td>
                          <td className="px-2 py-3 text-center">{entry.ayahCount}</td>
                          <td className="px-2 py-3 text-center font-bold text-slate-800">{fmt(entry.pages)}</td>
                        </>
                      )}
                    </tr>
                  ));
                })}
                {visibleRows.length === 0 && (
                  <tr><td colSpan={7} className="p-10 text-center text-sm text-slate-500">لا توجد أيام لعرضها في هذا الشهر.</td></tr>
                )}
              </tbody>
            </table>
          </div>
        )}
      </section>

      {/* الترقيم */}
      <nav aria-label="صفحات الجدول" className="flex items-center justify-end gap-3 text-sm">
        <button
          type="button"
          onClick={() => setPage((p) => Math.max(1, p - 1))}
          disabled={safePage <= 1}
          className="min-h-10 rounded-xl border border-slate-200 bg-white px-4 font-bold text-slate-700 hover:bg-emerald-50 disabled:cursor-not-allowed disabled:opacity-40"
        >
          السابق
        </button>
        <span className="font-bold text-slate-600">{safePage}\{pageCount}</span>
        <button
          type="button"
          onClick={() => setPage((p) => Math.min(pageCount, p + 1))}
          disabled={safePage >= pageCount}
          className="min-h-10 rounded-xl border border-slate-200 bg-white px-4 font-bold text-slate-700 hover:bg-emerald-50 disabled:cursor-not-allowed disabled:opacity-40"
        >
          التالي
        </button>
      </nav>

      {/* إحصائيات الحفظ والمراجعة */}
      <section className="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm md:p-5">
        <button
          type="button"
          onClick={() => setShowStats((v) => !v)}
          aria-expanded={showStats}
          className="flex w-full items-center justify-between gap-3 text-right"
        >
          <span className="text-base font-extrabold text-slate-800">إحصائيات الحفظ والمراجعة</span>
          <ChevronDown size={18} className={`text-slate-400 transition ${showStats ? "rotate-180" : ""}`} />
        </button>

        {showStats && (
          <div className="mt-4 space-y-4">
            <p className="text-sm text-slate-400">إحصائيات شهر {monthNumber}</p>
            <div className="grid gap-4 md:grid-cols-2">
              <StatsBlock title="الحفظ" stats={monthStats.memorization} />
              <StatsBlock title="المراجعة" stats={monthStats.review} />
            </div>

            <div className="flex flex-wrap items-end gap-4 border-t border-slate-100 pt-4">
              <label className="text-sm font-semibold text-slate-600">
                من تاريخ
                <input type="date" value={rangeFrom} onChange={(e) => setRangeFrom(e.target.value)} className={`${controlClass} mt-1 block`} />
              </label>
              <label className="text-sm font-semibold text-slate-600">
                إلى تاريخ
                <input type="date" value={rangeTo} onChange={(e) => setRangeTo(e.target.value)} className={`${controlClass} mt-1 block`} />
              </label>
              <p className="pb-3 text-xs text-slate-400">اختر فترة مخصصة لعرض مجموعها.</p>
            </div>

            {rangeStats && (
              <div className="grid gap-4 md:grid-cols-2">
                <StatsBlock title="الحفظ في الفترة" stats={rangeStats.memorization} />
                <StatsBlock title="المراجعة في الفترة" stats={rangeStats.review} />
              </div>
            )}

            {monthStats.invalid.length > 0 && (
              <p role="alert" className="text-xs text-rose-600">{monthStats.invalid.length} سجل غير صالح لم يُحتسب.</p>
            )}
          </div>
        )}
      </section>
    </main>
  );
}