# انسخ هذا الملف إلى .env على السيرفر ثم عدّل القيم.
# كلمة المرور: حروف وأرقام فقط (بدون ; أو $ أو مسافات) لأنها تدخل في سلسلة الاتصال.
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# لا يقل عن 32 بايت. للتوليد على السيرفر: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
# نطاق الواجهة كما يظهر في المتصفح، بدون / في النهاية
FRONTEND_ORIGIN=https://abdullahdev.cloud
