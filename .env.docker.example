# Copy this file to .env, then replace both values before starting the API.
# استخدم Development للتجربة المحلية فقط (يفعّل Swagger)
ASPNETCORE_ENVIRONMENT=Production
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
DB_CONNECTION=Host=host.docker.internal;Port=5432;Database=halaqa_db;Username=YOUR_DATABASE_USER;Password=YOUR_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
